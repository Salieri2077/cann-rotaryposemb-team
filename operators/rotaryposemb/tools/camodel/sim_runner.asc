// Independent parameterized test runner. This file is never submitted.
// CAModel usage: rope_sim_runner CASE_DIR B S H D {float32|float16} THETA [CORES=1] [ITERATIONS=1] [DEVICE=0]
// CORES is explicit; this runner never queries hardware core attributes.
#ifndef ROPE_KERNEL_SHA
#define ROPE_KERNEL_SHA "unknown"
#endif
#include <cstdint>
#include <cstdio>
#include <cstdlib>
#include <cmath>
#include <chrono>
#include <fstream>
#include <stdexcept>
#include <string>
#include <vector>
#include "acl/acl.h"

struct TensorInfo { const int64_t* shape; int64_t numDims; int32_t dtype; };
struct TensorGroupInfo { const TensorInfo* tensors; int64_t numTensors; };
#include "kernel.asc"

#define ACL_CHECK(expr) do { const aclError e = (expr); if (e != 0) { \
    std::fprintf(stderr, "%s failed with ACL error %d\n", #expr, int(e)); return 1; } } while (0)

static bool ReadExact(const std::string& path, std::vector<uint8_t>& data) {
    std::ifstream file(path, std::ios::binary | std::ios::ate);
    if (!file || file.tellg() != std::streampos(data.size())) return false;
    file.seekg(0);
    file.read(reinterpret_cast<char*>(data.data()), data.size());
    return bool(file);
}

int main(int argc, char** argv) {
    if (argc < 8 || argc > 11) {
        std::fprintf(stderr, "Usage: %s CASE_DIR B S H D {float32|float16} THETA [CORES=1] [ITERATIONS=1] [DEVICE=0]\n", argv[0]);
        return 2;
    }
    try {
        int64_t shape[4];
        for (int i = 0; i < 4; ++i) shape[i] = std::stoll(argv[i + 2]);
        const std::string dtypeName(argv[6]);
        const int32_t dtype = dtypeName == "float32" ? 0 : dtypeName == "float16" ? 1 : -1;
        const float theta = std::stof(argv[7]);
        const int64_t cores = argc >= 9 ? std::stoll(argv[8]) : 1;
        const int iterations = argc >= 10 ? std::stoi(argv[9]) : 1;
        const int device = argc >= 11 ? std::stoi(argv[10]) : 0;
        if (shape[0] < 1 || shape[0] > 128 || shape[1] < 1 || shape[1] > 8192 ||
            shape[2] < 1 || shape[2] > 256 || shape[3] < 16 || shape[3] > 1024 ||
            shape[3] % 2 || dtype < 0 || !std::isfinite(theta) || theta <= 0 ||
            cores < 1 || cores > 65535 || iterations < 1 || iterations > 100000 || device < 0) {
            throw std::runtime_error("Arguments outside the supported contract");
        }
        const size_t bytes = size_t(shape[0]) * shape[1] * shape[2] * shape[3] * (dtype == 0 ? 4 : 2);
        const size_t posBytes = size_t(shape[0]) * shape[1] * sizeof(int32_t);
        const std::string directory(argv[1]);
        std::vector<uint8_t> x(bytes), p(posBytes), y(bytes);
        if (!ReadExact(directory + "/x.bin", x) || !ReadExact(directory + "/positions.bin", p))
            throw std::runtime_error("Input binary file missing or has incorrect byte count");
        int64_t posShape[] = {shape[0], shape[1]};
        TensorInfo xi{shape, 4, dtype}, pi{posShape, 2, 5}, yi{shape, 4, dtype};
        TensorGroupInfo xg{&xi, 1}, pg{&pi, 1}, yg{&yi, 1};
        uint8_t *xd = nullptr, *pd = nullptr, *yd = nullptr;
        aclrtStream stream = nullptr;
        ACL_CHECK(aclInit(nullptr));
        ACL_CHECK(aclrtSetDevice(device));
        ACL_CHECK(aclrtCreateStream(&stream));
        ACL_CHECK(aclrtMalloc(reinterpret_cast<void**>(&xd), bytes, ACL_MEM_MALLOC_HUGE_FIRST));
        ACL_CHECK(aclrtMalloc(reinterpret_cast<void**>(&pd), posBytes, ACL_MEM_MALLOC_HUGE_FIRST));
        ACL_CHECK(aclrtMalloc(reinterpret_cast<void**>(&yd), bytes, ACL_MEM_MALLOC_HUGE_FIRST));
        ACL_CHECK(aclrtMemcpy(xd, bytes, x.data(), bytes, ACL_MEMCPY_HOST_TO_DEVICE));
        ACL_CHECK(aclrtMemcpy(pd, posBytes, p.data(), posBytes, ACL_MEMCPY_HOST_TO_DEVICE));
        ACL_CHECK(aclrtMemset(yd, bytes, 0xff, bytes));
        // No warmup: default iterations=1 means exactly one kernel launch.
        const auto start = std::chrono::steady_clock::now();
        for (int i = 0; i < iterations; ++i)
            run_kernel((GM_ADDR)xd, xg, (GM_ADDR)pd, pg, (GM_ADDR)yd, yg, cores, stream, theta);
        ACL_CHECK(aclrtSynchronizeStream(stream));
        const auto end = std::chrono::steady_clock::now();
        const double micros = std::chrono::duration<double, std::micro>(end - start).count() / iterations;
        ACL_CHECK(aclrtMemcpy(y.data(), bytes, yd, bytes, ACL_MEMCPY_DEVICE_TO_HOST));
        std::ofstream output(directory + "/y.bin", std::ios::binary | std::ios::trunc);
        output.write(reinterpret_cast<const char*>(y.data()), y.size());
        output.close();
        if (!output) throw std::runtime_error("Cannot write output binary");
        ACL_CHECK(aclrtFree(xd));
        ACL_CHECK(aclrtFree(pd));
        ACL_CHECK(aclrtFree(yd));
        ACL_CHECK(aclrtDestroyStream(stream));
        ACL_CHECK(aclrtResetDevice(device));
        ACL_CHECK(aclFinalize());
        // CAModel process wall time includes host tiling, simulator execution,
        // launch overhead and synchronization. It is not NPU kernel latency.
        std::printf("{\"mode\":\"sim\",\"simulation_host_batch_average_us\":%.6f,"
                    "\"iterations\":%d,\"requested_vector_cores\":%lld,"
                    "\"kernel_sha256\":\"%s\"}\n",
                    micros, iterations, static_cast<long long>(cores), ROPE_KERNEL_SHA);
        return 0;
    } catch (const std::exception& e) {
        std::fprintf(stderr, "CAModel validation runner: %s\n", e.what());
        return 1;
    }
}
