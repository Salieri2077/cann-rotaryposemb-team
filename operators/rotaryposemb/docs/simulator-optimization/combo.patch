+// wideAngles encoding preserves the launch payload size: 0 keeps the normal
+// theta>=1 path; 1 always uses Payne-Hanek; limit+2 allows vector reduction
+// only when every position in this coefficient window is <= limit.
+inline uint32_t EncodeWideAngleLimit(float maxFrequency)
+{
+    if (!std::isfinite(maxFrequency) || maxFrequency <= 0.0f) return 1;
+    const float estimate = 131072.0f / maxFrequency;
+    uint32_t limit = estimate >= 131072.0f ? 131072u : uint32_t(estimate);
+    union FloatBits { float f; uint32_t u; } frequency, position;
+    frequency.f = maxFrequency;
+    // Division can round upward across an integer. Verify the FP32 product
+    // with exact RNE integer arithmetic. Positive multiplication is monotone,
+    // so this bounds every live angle by the existing fast-path limit.
+    position.f = static_cast<float>(limit);
+    while (host_math::MultiplyPositiveRne(position.u, frequency.u) > 0x48000000u) {
+        --limit;
+        position.f = static_cast<float>(limit);
+    }
+    return limit + 2u;
+}
+
+__aicore__ inline bool NeedWideReduction(uint32_t mode, uint32_t maxPosition)
+{
+    return mode != 0 && (mode == 1 || maxPosition > mode - 2u);
+}
