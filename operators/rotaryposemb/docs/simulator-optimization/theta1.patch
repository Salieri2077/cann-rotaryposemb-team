+    // theta==1 gives exactly unit frequencies. Only aligned wide rows use
+    // this path, so every broadcast lane is real and no padding is changed.
+    __aicore__ inline void FinishUnitFrequencyTrig(uint32_t tokens)
+    {
+        const event_t anglesReady =
+            static_cast<event_t>(pipe_.FetchEventID(HardEvent::S_V));
+        SetFlag<HardEvent::S_V>(anglesReady);
+        WaitFlag<HardEvent::S_V>(anglesReady);
+        FinishTrig(tokens);
+        const event_t coefficientsReady =
+            static_cast<event_t>(pipe_.FetchEventID(HardEvent::V_S));
+        SetFlag<HardEvent::V_S>(coefficientsReady);
+        WaitFlag<HardEvent::V_S>(coefficientsReady);
+        auto cosine = AngleBuffer(5);
+        auto sine = AngleBuffer(6);
+        // Descending expansion cannot overwrite any unread compact source.
+        for (uint32_t pending = tokens; pending > 0; --pending) {
+            const uint32_t token = pending - 1;
+            const float cosValue = cosine.GetValue(token);
+            const float sinValue = sine.GetValue(token);
+            Duplicate(cosine[token * RowStride()], cosValue, RowStride());
+            Duplicate(sine[token * RowStride()], sinValue, RowStride());
+        }
+        PipeBarrier<PIPE_V>();
+    }
+
