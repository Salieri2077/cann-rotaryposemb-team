// RotaryPosEmb initial implementation for CANNJudge, CANN 9.0 / dav-2201.
// Only kernel.asc is submitted. main.asc supplies TensorGroupInfo and ACL types.
// See README.md for validation status and the NumPy/libm power precision caveat.
#include <cmath>
#include <cstdint>
#include "kernel_operator.h"
#include "tiling/tiling_api.h"

namespace rope_draft {
using namespace AscendC;

constexpr uint32_t kHalfTileElements = 4096;
constexpr uint32_t kSmallTileElements = 2048;
constexpr uint32_t kMaxAngles = 2048;
constexpr uint32_t kRawFrequencyCapacity = 343;
constexpr uint32_t kFrequencyGroups = 171;
constexpr uint32_t kPositionCache = 64;
constexpr uint32_t kMaxHeadRepeats = 128;


// Scalar fallback for FP32 angles outside the fast three-split range.
// The 192-bit 1/(2*pi) expansion is a mathematical constant, not input data.
// No host floating-point library or device double arithmetic is required.
// Returns an angle in [-pi, pi]; finite-input error is below 4e-7 radians.
__aicore__ inline float ReduceAnglePayneHanek(float angle)
{
    union FloatBits { float f; uint32_t u; } bits;
    bits.f = angle;
    const uint32_t magnitude = bits.u & 0x7fffffffu;
    if (magnitude >= 0x7f800000u) {
        bits.u = 0x7fc00000u;
        return bits.f;
    }
    // Preserve zero (including -0), subnormals, and already small arguments.
    if (magnitude <= 0x40490fdbu) return angle;

    const uint32_t mantissa = (magnitude & 0x007fffffu) | 0x00800000u;
    const int32_t exponent = int32_t(magnitude >> 23) - 127;
    const uint32_t reciprocal[6] = {
        0x4f10e410u, 0x36d8a566u, 0x7d4d3770u,
        0x7f09d5f4u, 0x9391054au, 0x28be60dbu
    };
    uint32_t product[7];
    uint64_t carry = 0;
    for (uint32_t i = 0; i < 6; ++i) {
        const uint64_t partial = uint64_t(mantissa) * reciprocal[i] + carry;
        product[i] = uint32_t(partial);
        carry = partial >> 32;
    }
    product[6] = uint32_t(carry);

    // angle/(2*pi) = product * 2^(exponent-215). Extract the
    // most significant 32 fractional bits. Their sign bit selects
    // the nearest integer without subtracting two nearly equal floats.
    const uint32_t fractionalShift = uint32_t(215 - exponent);
    const uint32_t firstBit = fractionalShift - 32;
    const uint32_t word = firstBit >> 5;
    const uint32_t bit = firstBit & 31;
    uint32_t fraction = product[word] >> bit;
    if (bit != 0) fraction |= product[word + 1] << (32 - bit);
    // Avoid implementation-defined unsigned-to-signed integer conversion.
    const int32_t signedFraction = fraction < 0x80000000u
        ? int32_t(fraction) : -int32_t(0xffffffffu - fraction) - 1;
    const float turns = float(signedFraction) * 2.3283064365386962890625e-10f;
    const float reduced = turns * 6.2831853071795864769253f;
    return (bits.u & 0x80000000u) ? -reduced : reduced;
}



// Identical integer IEEE-754 predictors in host and device execution spaces.
// Residuals restore the exact host-generated frequency bits; no approximation
// reaches the rotation. Keeping the two execution spaces explicit is portable.
namespace host_math {


inline uint64_t RoundRightEven(uint64_t value, uint32_t shift)
{
    if (shift == 0) return value;
    // Here value has at most 48 significant bits.
    if (shift >= 64) return 0;
    const uint64_t quotient = value >> shift;
    const uint64_t halfway = uint64_t(1) << (shift - 1);
    const uint64_t remainder = value & ((uint64_t(1) << shift) - 1);
    return quotient + uint64_t(remainder > halfway ||
                               (remainder == halfway && (quotient & 1)));
}

// Correctly rounded round-to-nearest, ties-to-even FP32 product.
// Operands and result are IEEE-754 raw uint32 bits, with positive sign.
// All finite positive values, subnormals, zero, +Inf and NaN are supported.
// NaNs (including 0*Inf) produce the canonical positive quiet NaN.
// There is no floating-point arithmetic, so FP32 FTZ modes cannot change it.
inline uint32_t MultiplyPositiveRne(uint32_t a, uint32_t b)
{
    const uint32_t expA = (a >> 23) & 255u;
    const uint32_t expB = (b >> 23) & 255u;
    uint32_t sigA = a & 0x007fffffu;
    uint32_t sigB = b & 0x007fffffu;
    if ((expA == 255u && sigA != 0) || (expB == 255u && sigB != 0)) {
        return 0x7fc00000u;
    }
    const bool zeroA = expA == 0 && sigA == 0;
    const bool zeroB = expB == 0 && sigB == 0;
    if (expA == 255u || expB == 255u) {
        return (zeroA || zeroB) ? 0x7fc00000u : 0x7f800000u;
    }
    if (zeroA || zeroB) return 0;
    int32_t eA = expA == 0 ? -126 : int32_t(expA) - 127;
    int32_t eB = expB == 0 ? -126 : int32_t(expB) - 127;
    if (expA != 0) sigA |= 0x00800000u;
    else {
        while (sigA < 0x00800000u) { sigA <<= 1; --eA; }
    }
    if (expB != 0) sigB |= 0x00800000u;
    else {
        while (sigB < 0x00800000u) { sigB <<= 1; --eB; }
    }

    const uint64_t product = uint64_t(sigA) * uint64_t(sigB);
    const bool upper = (product & (uint64_t(1) << 47)) != 0;
    int32_t exponent = eA + eB + int32_t(upper);
    if (exponent < -126) {
        // Subnormal units are 2^-149. The product's scale is 2^(eA+eB-46).
        const uint32_t shift = uint32_t(-eA - eB - 103);
        // Rounding may promote the largest subnormal to the smallest normal.
        return uint32_t(RoundRightEven(product, shift));
    }
    uint32_t significand = uint32_t(RoundRightEven(product, upper ? 24 : 23));
    if (significand == 0x01000000u) { significand >>= 1; ++exponent; }
    if (exponent > 127) return 0x7f800000u;
    return (uint32_t(exponent + 127) << 23) | (significand & 0x007fffffu);
}

}

namespace device_math {

// Preconditions: positive normal operands; exponent sum in [128, 380].
// RNE rounding uses one integer add; exponent carry is incorporated in bits.
__aicore__ inline uint32_t MultiplyNormalRne(uint32_t a, uint32_t b)
{
    const uint64_t product = uint64_t((a & 0x007fffffu) | 0x00800000u)
        * uint64_t((b & 0x007fffffu) | 0x00800000u);
    const uint32_t upper = uint32_t(product >> 47);
    const uint32_t shift = 23u + upper;
    const uint64_t rounded = (product + (uint64_t(1) << (shift - 1)) - 1
        + ((product >> shift) & 1u)) >> shift;
    const uint32_t exponent = (a >> 23) + (b >> 23) - 127u + upper;
    return ((exponent - 1u) << 23) + uint32_t(rounded);
}


__aicore__ inline uint64_t RoundRightEven(uint64_t value, uint32_t shift)
{
    if (shift == 0) return value;
    // Here value has at most 48 significant bits.
    if (shift >= 64) return 0;
    const uint64_t quotient = value >> shift;
    const uint64_t halfway = uint64_t(1) << (shift - 1);
    const uint64_t remainder = value & ((uint64_t(1) << shift) - 1);
    return quotient + uint64_t(remainder > halfway ||
                               (remainder == halfway && (quotient & 1)));
}

// Correctly rounded round-to-nearest, ties-to-even FP32 product.
// Operands and result are IEEE-754 raw uint32 bits, with positive sign.
// All finite positive values, subnormals, zero, +Inf and NaN are supported.
// NaNs (including 0*Inf) produce the canonical positive quiet NaN.
// There is no floating-point arithmetic, so FP32 FTZ modes cannot change it.
__aicore__ inline uint32_t MultiplyPositiveRne(uint32_t a, uint32_t b)
{
    const uint32_t expA = (a >> 23) & 255u;
    const uint32_t expB = (b >> 23) & 255u;
    uint32_t sigA = a & 0x007fffffu;
    uint32_t sigB = b & 0x007fffffu;
    if ((expA == 255u && sigA != 0) || (expB == 255u && sigB != 0)) {
        return 0x7fc00000u;
    }
    const bool zeroA = expA == 0 && sigA == 0;
    const bool zeroB = expB == 0 && sigB == 0;
    if (expA == 255u || expB == 255u) {
        return (zeroA || zeroB) ? 0x7fc00000u : 0x7f800000u;
    }
    if (zeroA || zeroB) return 0;
    int32_t eA = expA == 0 ? -126 : int32_t(expA) - 127;
    int32_t eB = expB == 0 ? -126 : int32_t(expB) - 127;
    if (expA != 0) sigA |= 0x00800000u;
    else {
        while (sigA < 0x00800000u) { sigA <<= 1; --eA; }
    }
    if (expB != 0) sigB |= 0x00800000u;
    else {
        while (sigB < 0x00800000u) { sigB <<= 1; --eB; }
    }

    const uint64_t product = uint64_t(sigA) * uint64_t(sigB);
    const bool upper = (product & (uint64_t(1) << 47)) != 0;
    int32_t exponent = eA + eB + int32_t(upper);
    if (exponent < -126) {
        // Subnormal units are 2^-149. The product's scale is 2^(eA+eB-46).
        const uint32_t shift = uint32_t(-eA - eB - 103);
        // Rounding may promote the largest subnormal to the smallest normal.
        return uint32_t(RoundRightEven(product, shift));
    }
    uint32_t significand = uint32_t(RoundRightEven(product, upper ? 24 : 23));
    if (significand == 0x01000000u) { significand >>= 1; ++exponent; }
    if (exponent > 127) return 0x7f800000u;
    return (uint32_t(exponent + 127) << 23) | (significand & 0x007fffffu);
}

}

struct LaunchConfig {
    uint64_t tokens;
    uint64_t workUnits;
    uint32_t heads;
    uint32_t dim;
    uint32_t halfDim;
    uint32_t rowStride;
    uint32_t headGroup;
    uint32_t groups;
    uint32_t tokenGrain;
    uint32_t batchTokens;
    uint32_t tileHeads;
    uint32_t angleCapacity;
    uint32_t tileElements;
    uint32_t blockCount;
    uint32_t batched;
    uint32_t wideAngles;
    // Attribute-derived constants, computed afresh INSIDE run_kernel.
    // No tensor data, saved answers, position table, or cross-call cache.
    uint32_t encodedFrequency;
    union FrequencyStorage {
        float raw[kRawFrequencyCapacity];
        struct Packed {
            uint32_t ratioBits;
            uint32_t anchor[kFrequencyGroups];
            int16_t residual[2 * kFrequencyGroups];
        } packed;
    } frequency;
};
static_assert(sizeof(LaunchConfig) + 3 * sizeof(uint64_t) <= 1536,
              "Configuration and three GM addresses must fit the 1536-byte limit.");

// Small public dimensions carry only their live raw frequencies.
// The compact config is copied on the host and passed directly to the device.
template<uint32_t RawCapacity>
struct CompactLaunchConfig {
    uint64_t tokens;
    uint64_t workUnits;
    uint32_t heads;
    uint32_t dim;
    uint32_t halfDim;
    uint32_t rowStride;
    uint32_t headGroup;
    uint32_t groups;
    uint32_t tokenGrain;
    uint32_t batchTokens;
    uint32_t tileHeads;
    uint32_t angleCapacity;
    uint32_t tileElements;
    uint32_t blockCount;
    uint32_t batched;
    uint32_t wideAngles;
    // Attribute-derived constants, computed afresh INSIDE run_kernel.
    // No tensor data, saved answers, position table, or cross-call cache.
    uint32_t encodedFrequency;
    struct RawFrequencyStorage { float raw[RawCapacity]; } frequency;
};

template<uint32_t FixedDim> struct ConfigSelector { using Type = LaunchConfig; };
template<> struct ConfigSelector<16> { using Type = CompactLaunchConfig<8>; };
template<> struct ConfigSelector<32> { using Type = CompactLaunchConfig<16>; };
template<> struct ConfigSelector<64> { using Type = CompactLaunchConfig<32>; };
template<> struct ConfigSelector<128> { using Type = CompactLaunchConfig<64>; };
template<uint32_t FixedDim>
using KernelConfig = typename ConfigSelector<FixedDim>::Type;

static_assert(sizeof(CompactLaunchConfig<8>) + 3 * sizeof(uint64_t) == 136,
              "D16 uses a 136-byte launch payload.");
static_assert(sizeof(CompactLaunchConfig<16>) + 3 * sizeof(uint64_t) == 168,
              "D32 uses a 168-byte launch payload.");
static_assert(sizeof(CompactLaunchConfig<32>) + 3 * sizeof(uint64_t) == 232,
              "D64 uses a 232-byte launch payload.");
static_assert(sizeof(CompactLaunchConfig<64>) + 3 * sizeof(uint64_t) == 360,
              "D128 uses a 360-byte launch payload.");

template<uint32_t RawCapacity>
inline CompactLaunchConfig<RawCapacity> MakeCompactConfig(const LaunchConfig& source)
{
    CompactLaunchConfig<RawCapacity> compact{};
    compact.tokens = source.tokens;
    compact.workUnits = source.workUnits;
    compact.heads = source.heads;
    compact.dim = source.dim;
    compact.halfDim = source.halfDim;
    compact.rowStride = source.rowStride;
    compact.headGroup = source.headGroup;
    compact.groups = source.groups;
    compact.tokenGrain = source.tokenGrain;
    compact.batchTokens = source.batchTokens;
    compact.tileHeads = source.tileHeads;
    compact.angleCapacity = source.angleCapacity;
    compact.tileElements = source.tileElements;
    compact.blockCount = source.blockCount;
    compact.batched = source.batched;
    compact.wideAngles = source.wideAngles;
    compact.encodedFrequency = source.encodedFrequency;
    for (uint32_t i = 0; i < RawCapacity; ++i) {
        compact.frequency.raw[i] = source.frequency.raw[i];
    }
    return compact;
}

inline uint32_t CeilDiv(uint32_t a, uint32_t b) { return (a + b - 1) / b; }
inline uint32_t Min(uint32_t a, uint32_t b) { return a < b ? a : b; }
inline uint32_t Gcd(uint32_t a, uint32_t b)
{
    while (b) { const uint32_t r = a % b; a = b; b = r; }
    return a;
}

template<class T>
struct Convert {
    __aicore__ static inline LocalTensor<float> Input(
        LocalTensor<T> src, LocalTensor<float> work, uint32_t n)
    {
        Cast(work, src, RoundMode::CAST_NONE, n);
        return work;
    }
    __aicore__ static inline LocalTensor<float> Output(
        LocalTensor<T>, LocalTensor<float> work) { return work; }
    __aicore__ static inline void Store(
        LocalTensor<T> dst, LocalTensor<float> src, uint32_t n)
    {
        Cast(dst, src, RoundMode::CAST_RINT, n);
    }
};

template<>
struct Convert<float> {
    __aicore__ static inline LocalTensor<float> Input(
        LocalTensor<float> src, LocalTensor<float>, uint32_t) { return src; }
    __aicore__ static inline LocalTensor<float> Output(
        LocalTensor<float> dst, LocalTensor<float>) { return dst; }
    __aicore__ static inline void Store(
        LocalTensor<float>, LocalTensor<float>, uint32_t) {}
};

template<class T, uint32_t FixedDim = 0>
class Kernel {
public:
    using Config = KernelConfig<FixedDim>;
    static_assert(FixedDim == 0 || FixedDim == 16 || FixedDim == 32 || FixedDim == 64 || FixedDim == 128,
                  "Only the public D=16/32/64/128 specializations are enabled.");
    __aicore__ static inline uint32_t Dim(const Config& config)
    {
        return FixedDim != 0 ? FixedDim : config.dim;
    }
    __aicore__ static inline uint32_t HalfDim(const Config& config)
    {
        return FixedDim != 0 ? FixedDim / 2 : config.halfDim;
    }
    __aicore__ static inline uint32_t RowStride(const Config& config)
    {
        // D16 half needs sixteen-element rows; float needs eight.
        // Preserve 32-byte padding even when only the logical frequencies travel.
        constexpr uint32_t alignment = 32 / sizeof(T);
        return FixedDim != 0
            ? ((FixedDim / 2 + alignment - 1) / alignment) * alignment
            : config.rowStride;
    }
    __aicore__ inline uint32_t Dim() const { return Dim(*cfg_); }
    __aicore__ inline uint32_t HalfDim() const { return HalfDim(*cfg_); }
    __aicore__ inline uint32_t RowStride() const { return RowStride(*cfg_); }

    __aicore__ inline void Init(GM_ADDR x, GM_ADDR positions, GM_ADDR y,
                               const Config& config)
    {
        cfg_ = &config;
        x_.SetGlobalBuffer((__gm__ T*)x);
        y_.SetGlobalBuffer((__gm__ T*)y);
        positions_.SetGlobalBuffer((__gm__ int32_t*)positions);
        const uint32_t ioBytes = 2 * cfg_->tileElements * sizeof(T);
        pipe_.InitBuffer(inputQueue_, 2, ioBytes);
        pipe_.InitBuffer(outputQueue_, 2, ioBytes);
        pipe_.InitBuffer(positionBuffer_, kPositionCache * sizeof(int32_t));
        positionLocal_ = positionBuffer_.Get<int32_t>();
        // float operands already reside in input/output queues; only half needs conversion storage.
        const uint32_t fpWorkBytes = sizeof(T) == sizeof(float)
            ? 32u : 4 * cfg_->tileElements * sizeof(float);
        pipe_.InitBuffer(fpWork_, fpWorkBytes);
        pipe_.InitBuffer(product_, cfg_->tileElements * sizeof(float));
        pipe_.InitBuffer(frequencies_, RowStride(config) * sizeof(float));
        pipe_.InitBuffer(angleWork_, 7 * config.angleCapacity * sizeof(float));

        auto freq = frequencies_.Get<float>();
        // Separate raw and compressed loops: avoid division/modulo and format
        // branches on every lane. Padding is still explicitly initialized.
        InitFrequencies(freq, config);
        for (uint32_t i = HalfDim(config); i < RowStride(config); ++i) {
            freq.SetValue(i, 0.0f);
        }
        const event_t event = static_cast<event_t>(pipe_.FetchEventID(HardEvent::S_V));
        SetFlag<HardEvent::S_V>(event);
        WaitFlag<HardEvent::S_V>(event);
    }

    template<uint32_t RawCapacity>
    __aicore__ inline void InitFrequencies(
        LocalTensor<float> freq, const CompactLaunchConfig<RawCapacity>& config)
    {
        for (uint32_t i = 0; i < RawCapacity; ++i) {
            freq.SetValue(i, config.frequency.raw[i]);
        }
    }

    __aicore__ inline void InitFrequencies(
        LocalTensor<float> freq, const LaunchConfig& config)
    {
        if (!config.encodedFrequency) {
            for (uint32_t i = 0; i < config.halfDim; ++i) {
                freq.SetValue(i, config.frequency.raw[i]);
            }
        } else if (config.encodedFrequency & 256u) {
            InitEncodedFrequency<true>(freq, config);
        } else {
            InitEncodedFrequency<false>(freq, config);
        }
    }

    template<bool normal>
    __aicore__ inline void InitEncodedFrequency(
        LocalTensor<float> freq, const LaunchConfig& config)
    {
        const uint32_t ratio = config.frequency.packed.ratioBits;
        for (uint32_t base = 0, group = 0; base < config.halfDim; base += 3, ++group) {
            union FloatBits { float f; uint32_t u; } bits;
            bits.u = config.frequency.packed.anchor[group];
            freq.SetValue(base, bits.f);
            if (base + 1 < config.halfDim) {
                uint32_t predicted = normal
                    ? device_math::MultiplyNormalRne(bits.u, ratio)
                    : device_math::MultiplyPositiveRne(bits.u, ratio);
                bits.u = predicted + uint32_t(int32_t(config.frequency.packed.residual[2 * group]));
                freq.SetValue(base + 1, bits.f);
                if (base + 2 < config.halfDim) {
                    predicted = normal
                        ? device_math::MultiplyNormalRne(bits.u, ratio)
                        : device_math::MultiplyPositiveRne(bits.u, ratio);
                    bits.u = predicted + uint32_t(int32_t(config.frequency.packed.residual[2 * group + 1]));
                    freq.SetValue(base + 2, bits.f);
                }
            }
        }
    }

    __aicore__ inline void Process()
    {
        const uint64_t block = GetBlockIdx();
        const uint64_t perBlock = cfg_->workUnits / cfg_->blockCount;
        const uint64_t extra = cfg_->workUnits % cfg_->blockCount;
        const uint64_t begin = block * perBlock + (block < extra ? block : extra);
        const uint64_t end = begin + perBlock + (block < extra ? 1u : 0u);
        for (uint64_t unit = begin; unit < end; ++unit) {
            if (cfg_->batched) {
                ProcessTokenBatch(unit * cfg_->batchTokens);
            } else {
                const uint64_t tokenBegin = (unit / cfg_->groups) * cfg_->tokenGrain;
                const uint32_t headBegin = (unit % cfg_->groups) * cfg_->headGroup;
                uint32_t headCount = cfg_->heads - headBegin;
                if (headCount > cfg_->headGroup) headCount = cfg_->headGroup;
                uint64_t tokenEnd = tokenBegin + cfg_->tokenGrain;
                if (tokenEnd > cfg_->tokens) tokenEnd = cfg_->tokens;
                const uint32_t coeffTokens = cfg_->angleCapacity / RowStride();
                for (uint64_t coeffBegin = tokenBegin; coeffBegin < tokenEnd;
                     coeffBegin += coeffTokens) {
                    // Generate coefficients for several tokens with one vector pass.
                    const uint32_t remainingTokens = tokenEnd - coeffBegin;
                    const uint32_t tokenCount = remainingTokens < coeffTokens
                        ? remainingTokens : coeffTokens;
                    const uint64_t firstRow = coeffBegin * cfg_->heads + headBegin;
                    const uint32_t firstRows = headCount < cfg_->tileHeads
                        ? headCount : cfg_->tileHeads;
                    const int32_t firstPosition = Position(coeffBegin);
                    CopyIn(firstRow, firstRows);
                    for (uint32_t t = 0; t < tokenCount; ++t) {
                        Muls(AngleBuffer(0)[t * RowStride()], frequencies_.Get<float>(),
                             static_cast<float>(t == 0 ? firstPosition : Position(coeffBegin + t)),
                             RowStride());
                    }
                    PipeBarrier<PIPE_V>();
                    FinishTrig(tokenCount * RowStride());
                    for (uint32_t t = 0; t < tokenCount; ++t) {
                        ProcessSharedToken(coeffBegin + t, headBegin, headCount,
                                           t * RowStride(), t + 1 < tokenCount);
                    }
                }
            }
        }
    }

private:
    __aicore__ inline int32_t Position(uint64_t token)
    {
        if (!positionLive_ || token < cacheStart_ || token >= cacheEnd_) {
            if (positionLive_) {
                // The previous cache is consumed only by Scalar. Order its
                // final read before MTE2 overwrites the same UB allocation.
                const event_t recycle =
                    static_cast<event_t>(pipe_.FetchEventID(HardEvent::S_MTE2));
                SetFlag<HardEvent::S_MTE2>(recycle);
                WaitFlag<HardEvent::S_MTE2>(recycle);
            }
            cacheStart_ = token;
            uint32_t count = kPositionCache;
            if (cfg_->tokens - token < count) count = cfg_->tokens - token;
            cacheEnd_ = cacheStart_ + count;
            DataCopyExtParams cp{1, count * uint32_t(sizeof(int32_t)), 0, 0, 0};
            DataCopyPadExtParams<int32_t> pad{true, 0, 0, 0};
            DataCopyPad(positionLocal_, positions_[token], cp, pad);
            // Position data has no Vector consumer; synchronize MTE2 directly
            // to Scalar without adding a VECIN queue dependency to Vector.
            const event_t event =
                static_cast<event_t>(pipe_.FetchEventID(HardEvent::MTE2_S));
            SetFlag<HardEvent::MTE2_S>(event);
            WaitFlag<HardEvent::MTE2_S>(event);
            positionLive_ = true;
        }
        return positionLocal_.GetValue(token - cacheStart_);
    }

    __aicore__ inline LocalTensor<float> AngleBuffer(uint32_t index)
    {
        return angleWork_.Get<float>()[index * cfg_->angleCapacity];
    }

    __aicore__ inline void FinishTrig(uint32_t count)
    {
        auto angle = AngleBuffer(0);
        auto quotient = AngleBuffer(1);
        auto quotientInt = AngleBuffer(2).template ReinterpretCast<int32_t>();
        auto product = AngleBuffer(3);
        auto reduced = angle;
        auto cos = AngleBuffer(5);
        auto sin = AngleBuffer(6);
        if (cfg_->wideAngles) {
            // Rare theta<1 path: bounded quotient reduction is insufficient.
            // Only UB data is read here; global-memory traffic remains vectorized.
            const event_t toScalar =
                static_cast<event_t>(pipe_.FetchEventID(HardEvent::V_S));
            SetFlag<HardEvent::V_S>(toScalar);
            WaitFlag<HardEvent::V_S>(toScalar);
            for (uint32_t i = 0; i < count; ++i) {
                reduced.SetValue(i, ReduceAnglePayneHanek(angle.GetValue(i)));
            }
            const event_t toVector =
                static_cast<event_t>(pipe_.FetchEventID(HardEvent::S_V));
            SetFlag<HardEvent::S_V>(toVector);
            WaitFlag<HardEvent::S_V>(toVector);
        } else {
            // Preserve the FP32-rounded position * inverse-frequency product.
            // Never evaluate position * (log-frequency) as a fused approximation.
            Muls(quotient, angle, 0.15915494309189533577f, count);
            PipeBarrier<PIPE_V>();
            Cast(quotientInt, quotient, RoundMode::CAST_RINT, count);
            PipeBarrier<PIPE_V>();
            Cast(quotient, quotientInt, RoundMode::CAST_NONE, count);
            PipeBarrier<PIPE_V>();

            // q <= 20861. Products q*(201/32) and q*(507/2^18) are
            // exactly representable in FP32, so either fused or separate Axpy
            // gives the same subtraction result as the original Mul/Sub pair.
            // The nonexact third product deliberately keeps separate rounding.
            Muls(sin, quotient, 1.2556659143567085e-6f, count);
            Axpy(reduced, quotient, -6.28125f, count);
            PipeBarrier<PIPE_V>();
            Axpy(reduced, quotient, -0.001934051513671875f, count);
            PipeBarrier<PIPE_V>();
            Sub(reduced, reduced, sin, count);
            PipeBarrier<PIPE_V>();

        }

        // On the reduced domain, sin and cos share z = |r| * (pi - |r|).
        // This avoids two repeated generic range reductions in high-level APIs.
        auto absAngle = AngleBuffer(4);
        auto width = quotient;
        auto z = AngleBuffer(2);
        auto centered = product;
        Abs(absAngle, reduced, count);
        PipeBarrier<PIPE_V>();
        Muls(width, absAngle, -1.0f, count);
        PipeBarrier<PIPE_V>();
        Adds(centered, width, 1.57079637050628662109f, count);
        PipeBarrier<PIPE_V>();
        Adds(width, width, 3.14159274101257324219f, count);
        PipeBarrier<PIPE_V>();
        Adds(centered, centered, -4.371138828673793e-8f, count);
        Adds(width, width, -8.742277657347586e-8f, count);
        PipeBarrier<PIPE_V>();
        Mul(z, absAngle, width, count);
        Mul(reduced, reduced, width, count);
        PipeBarrier<PIPE_V>();

        Muls(sin, z, 2.580631073747187e-7f, count);
        Muls(cos, z, 2.3889217773452806e-8f, count);
        PipeBarrier<PIPE_V>();
        Adds(sin, sin, 2.1560553672307594e-5f, count);
        Adds(cos, cos, 2.457805570135570e-6f, count);
        PipeBarrier<PIPE_V>();
        Mul(sin, sin, z, count);
        Mul(cos, cos, z, count);
        PipeBarrier<PIPE_V>();
        Adds(sin, sin, 1.160294554180584e-3f, count);
        Adds(cos, cos, 1.726966512531477e-4f, count);
        PipeBarrier<PIPE_V>();
        Mul(sin, sin, z, count);
        Mul(cos, cos, z, count);
        PipeBarrier<PIPE_V>();
        Adds(sin, sin, 3.2251527327119334e-2f, count);
        Adds(cos, cos, 6.9616269567191625e-3f, count);
        PipeBarrier<PIPE_V>();
        Mul(sin, sin, z, count);
        Mul(cos, cos, z, count);
        PipeBarrier<PIPE_V>();
        Adds(sin, sin, 3.183098865345572e-1f, count);
        Adds(cos, cos, 1.2900613822529625e-1f, count);
        PipeBarrier<PIPE_V>();
        Mul(sin, sin, reduced, count);
        Mul(cos, cos, z, count);
        PipeBarrier<PIPE_V>();
        Adds(cos, cos, 6.366197723507009e-1f, count);
        PipeBarrier<PIPE_V>();
        Mul(cos, cos, centered, count);
        PipeBarrier<PIPE_V>();
    }

    __aicore__ inline bool ContiguousBatch(uint32_t rows) const
    {
        // Keep six arithmetic API calls and full vector utilization. Short
        // D16 tails that would require another call retain the split layout.
        return HalfDim() == 64 ||
            (HalfDim() == 8 && (rows <= 8 || rows % 8 == 0));
    }

    __aicore__ inline void CopyIn(uint64_t firstRow, uint32_t rows)
    {
        auto input = inputQueue_.template AllocTensor<T>();
        const uint32_t halfBytes = HalfDim() * sizeof(T);
        if (halfBytes % 32 == 0 && (!cfg_->batched || ContiguousBatch(rows))) {
            DataCopyExtParams contiguous{1, rows * Dim() * uint32_t(sizeof(T)), 0, 0, 0};
            DataCopyPadExtParams<T> noPad{false, 0, 0, static_cast<T>(0)};
            DataCopyPad(input, x_[firstRow * Dim()], contiguous, noPad);
            inputQueue_.EnQue(input);
            return;
        }
        DataCopyExtParams cp{static_cast<uint16_t>(rows), halfBytes, halfBytes, 0, 0};
        DataCopyPadExtParams<T> pad{
            true, 0, static_cast<uint8_t>(RowStride() - HalfDim()),
            static_cast<T>(0)};
        const uint64_t offset = firstRow * Dim();
        // Separate padded half-rows keep both vector operands 32B aligned.
        DataCopyPad(input, x_[offset], cp, pad);
        DataCopyPad(input[cfg_->tileElements], x_[offset + HalfDim()], cp, pad);
        inputQueue_.EnQue(input);
    }

    __aicore__ inline void CopyOut(uint64_t firstRow, uint32_t rows)
    {
        auto output = outputQueue_.template DeQue<T>();
        const uint32_t halfBytes = HalfDim() * sizeof(T);
        if (halfBytes % 32 == 0 && (!cfg_->batched || ContiguousBatch(rows))) {
            DataCopyExtParams contiguous{1, rows * Dim() * uint32_t(sizeof(T)), 0, 0, 0};
            DataCopyPad(y_[firstRow * Dim()], output, contiguous);
            outputQueue_.FreeTensor(output);
            return;
        }
        DataCopyExtParams cp{static_cast<uint16_t>(rows), halfBytes, 0, halfBytes, 0};
        const uint64_t offset = firstRow * Dim();
        DataCopyPad(y_[offset], output, cp);
        DataCopyPad(y_[offset + HalfDim()], output[cfg_->tileElements], cp);
        outputQueue_.FreeTensor(output);
    }

    __aicore__ inline void MultiplyTrig(
        LocalTensor<float> dst, LocalTensor<float> src,
        LocalTensor<float> trig, uint32_t rows, bool shared)
    {
        if (!shared) {
            Mul(dst, src, trig, rows * RowStride());
            return;
        }
        BinaryRepeatParams repeat;
        repeat.dstBlkStride = 1;
        repeat.src0BlkStride = 1;
        repeat.src1BlkStride = 1;
        repeat.dstRepStride = RowStride() / 8;
        repeat.src0RepStride = RowStride() / 8;
        repeat.src1RepStride = 0; // all heads reuse one token's coefficients
        for (uint32_t offset = 0; offset < RowStride(); offset += 64) {
            const uint64_t mask =
                RowStride() - offset < 64 ? RowStride() - offset : 64;
            Mul(dst[offset], src[offset], trig[offset], mask,
                static_cast<uint8_t>(rows), repeat);
        }
    }

    // Preserve full GM rows in UB when each half starts on a 32-byte boundary.
    // Repeats traverse heads; the coefficient repeat stride remains zero.
    __aicore__ inline void MultiplyContiguous(
        LocalTensor<float> dst, LocalTensor<float> src,
        LocalTensor<float> trig, uint32_t rows, bool compactDst)
    {
        BinaryRepeatParams repeat;
        repeat.dstBlkStride = 1;
        repeat.src0BlkStride = 1;
        repeat.src1BlkStride = 1;
        repeat.dstRepStride = (compactDst ? HalfDim() : Dim()) / 8;
        repeat.src0RepStride = Dim() / 8;
        repeat.src1RepStride = 0;
        for (uint32_t offset = 0; offset < HalfDim(); offset += 64) {
            const uint64_t mask = HalfDim() - offset < 64
                ? HalfDim() - offset : 64;
            Mul(dst[offset], src[offset], trig[offset], mask,
                static_cast<uint8_t>(rows), repeat);
        }
    }

    __aicore__ inline void CombineContiguous(
        LocalTensor<float> dst, LocalTensor<float> src,
        uint32_t rows, bool subtract, bool compactSrc = true)
    {
        BinaryRepeatParams repeat;
        repeat.dstBlkStride = 1;
        repeat.src0BlkStride = 1;
        repeat.src1BlkStride = 1;
        repeat.dstRepStride = Dim() / 8;
        repeat.src0RepStride = Dim() / 8;
        repeat.src1RepStride = (subtract && compactSrc ? HalfDim() : Dim()) / 8;
        for (uint32_t offset = 0; offset < HalfDim(); offset += 64) {
            const uint64_t mask = HalfDim() - offset < 64
                ? HalfDim() - offset : 64;
            if (subtract) {
                Sub(dst[offset], dst[offset], src[offset], mask,
                    static_cast<uint8_t>(rows), repeat);
            } else {
                Add(dst[offset], dst[offset], src[offset], mask,
                    static_cast<uint8_t>(rows), repeat);
            }
        }
    }


    // Both row halves multiply by the same coefficient period. With a short
    // period, repeat it across all 64 FP32 lanes; wider periods use one repeat
    // per half-row. No multiply-add contraction changes FP32 rounding.
    __aicore__ inline void MultiplyWholeRows(
        LocalTensor<float> dst, LocalTensor<float> src,
        LocalTensor<float> trig, uint32_t rows)
    {
        BinaryRepeatParams repeat;
        repeat.dstBlkStride = 1;
        repeat.src0BlkStride = 1;
        repeat.src1BlkStride = 1;
        repeat.src1RepStride = 0;
        if (HalfDim() < 64) {
            repeat.dstRepStride = 8;
            repeat.src0RepStride = 8;
            const uint32_t elements = rows * Dim();
            const uint32_t full = elements / 64;
            if (full != 0) Mul(dst, src, trig, uint64_t(64),
                              static_cast<uint8_t>(full), repeat);
            const uint32_t tail = elements % 64;
            if (tail != 0) Mul(dst[full * 64], src[full * 64], trig,
                              uint64_t(tail), uint8_t(1), repeat);
            return;
        }
        repeat.dstRepStride = HalfDim() / 8;
        repeat.src0RepStride = HalfDim() / 8;
        for (uint32_t offset = 0; offset < HalfDim(); offset += 64) {
            Mul(dst[offset], src[offset], trig[offset], uint64_t(64),
                static_cast<uint8_t>(2 * rows), repeat);
        }
    }

    __aicore__ inline void ComputeWholeRows(
        LocalTensor<T> input, uint32_t rows, uint32_t trigOffset)
    {
        const uint32_t elements = rows * Dim();
        auto output = outputQueue_.template AllocTensor<T>();
        auto work = fpWork_.Get<float>();
        auto values = Convert<T>::Input(input, work, elements);
        auto result = Convert<T>::Output(output,
            work[sizeof(T) == sizeof(float) ? 0 : 2 * cfg_->tileElements]);
        auto cos = AngleBuffer(5)[trigOffset];
        auto sin = AngleBuffer(6)[trigOffset];
        if (HalfDim() < 64) {
            auto packed = product_.Get<float>();
            CopyRepeatParams repeat{1, 1,
                static_cast<uint16_t>(HalfDim() / 8), 0};
            Copy(packed, cos, uint64_t(HalfDim()),
                 static_cast<uint8_t>(64 / HalfDim()), repeat);
            Copy(packed[64], sin, uint64_t(HalfDim()),
                 static_cast<uint8_t>(64 / HalfDim()), repeat);
            cos = packed;
            sin = packed[64];
        }
        PipeBarrier<PIPE_V>();
        MultiplyWholeRows(result, values, cos, rows);
        // Cosine has consumed every original value before the sine products
        // overwrite their exact same input slots. Repeats never overlap.
        PipeBarrier<PIPE_V>();
        MultiplyWholeRows(values, values, sin, rows);
        PipeBarrier<PIPE_V>();
        CombineContiguous(result, values[HalfDim()], rows, true, false);
        CombineContiguous(result[HalfDim()], values, rows, false, false);
        PipeBarrier<PIPE_V>();
        Convert<T>::Store(output, result, elements);
        outputQueue_.EnQue(output);
        inputQueue_.FreeTensor(input);
    }

    __aicore__ inline void ComputeContiguous(
        LocalTensor<T> input, uint32_t rows, uint32_t trigOffset)
    {
        if (HalfDim() % 64 == 0 ||
            (rows >= 8 && (HalfDim() == 8 || HalfDim() == 16 ||
                           HalfDim() == 32))) {
            ComputeWholeRows(input, rows, trigOffset);
            return;
        }
        const uint32_t elements = rows * Dim();
        auto output = outputQueue_.template AllocTensor<T>();
        auto work = fpWork_.Get<float>();
        auto a = Convert<T>::Input(input, work, elements);
        auto b = a[HalfDim()];
        auto u = Convert<T>::Output(output, work[sizeof(T) == sizeof(float) ? 0 : 2 * cfg_->tileElements]);
        auto v = u[HalfDim()];
        auto temp = product_.Get<float>();
        auto cos = AngleBuffer(5)[trigOffset];
        auto sin = AngleBuffer(6)[trigOffset];
        PipeBarrier<PIPE_V>();
        MultiplyContiguous(u, a, cos, rows, false);
        MultiplyContiguous(v, b, cos, rows, false);
        MultiplyContiguous(temp, b, sin, rows, true);
        PipeBarrier<PIPE_V>();
        CombineContiguous(u, temp, rows, true);
        MultiplyContiguous(b, a, sin, rows, false);
        PipeBarrier<PIPE_V>();
        CombineContiguous(v, b, rows, false);
        PipeBarrier<PIPE_V>();
        Convert<T>::Store(output, u, elements);
        outputQueue_.EnQue(output);
        inputQueue_.FreeTensor(input);
    }

    __aicore__ inline void MultiplyBatchedContiguous(
        LocalTensor<float> dst, LocalTensor<float> src,
        LocalTensor<float> trig, uint32_t rows, bool compactDst)
    {
        const bool stripe = HalfDim() == 8;
        BinaryRepeatParams repeat;
        repeat.dstBlkStride = stripe ? (compactDst ? 1 : 2) : 1;
        repeat.src0BlkStride = stripe ? 2 : 1;
        repeat.src1BlkStride = 1;
        repeat.dstRepStride = compactDst ? 8 : 16;
        repeat.src0RepStride = 16;
        repeat.src1RepStride = 8; // each row has its own expanded coefficients
        const uint64_t mask = stripe && rows < 8 ? rows * 8 : 64;
        const uint8_t repeats = stripe ? (rows + 7) / 8 : rows;
        Mul(dst, src, trig, mask, repeats, repeat);
    }

    __aicore__ inline void CombineBatchedContiguous(
        LocalTensor<float> dst, LocalTensor<float> src,
        uint32_t rows, bool subtract)
    {
        const bool stripe = HalfDim() == 8;
        BinaryRepeatParams repeat;
        repeat.dstBlkStride = stripe ? 2 : 1;
        repeat.src0BlkStride = stripe ? 2 : 1;
        repeat.src1BlkStride = stripe ? (subtract ? 1 : 2) : 1;
        repeat.dstRepStride = 16;
        repeat.src0RepStride = 16;
        repeat.src1RepStride = subtract ? 8 : 16;
        const uint64_t mask = stripe && rows < 8 ? rows * 8 : 64;
        const uint8_t repeats = stripe ? (rows + 7) / 8 : rows;
        if (subtract) Sub(dst, dst, src, mask, repeats, repeat);
        else Add(dst, dst, src, mask, repeats, repeat);
    }

    __aicore__ inline void ComputeBatchedContiguous(LocalTensor<T> input, uint32_t rows)
    {
        const uint32_t elements = rows * Dim();
        auto output = outputQueue_.template AllocTensor<T>();
        auto work = fpWork_.Get<float>();
        auto a = Convert<T>::Input(input, work, elements);
        auto b = a[HalfDim()];
        auto u = Convert<T>::Output(output,
            work[sizeof(T) == sizeof(float) ? 0 : 2 * cfg_->tileElements]);
        auto v = u[HalfDim()];
        auto temp = product_.Get<float>();
        auto cos = AngleBuffer(5);
        auto sin = AngleBuffer(6);
        PipeBarrier<PIPE_V>();
        MultiplyBatchedContiguous(u, a, cos, rows, false);
        MultiplyBatchedContiguous(v, b, cos, rows, false);
        MultiplyBatchedContiguous(temp, b, sin, rows, true);
        PipeBarrier<PIPE_V>();
        CombineBatchedContiguous(u, temp, rows, true);
        MultiplyBatchedContiguous(b, a, sin, rows, false);
        PipeBarrier<PIPE_V>();
        CombineBatchedContiguous(v, b, rows, false);
        PipeBarrier<PIPE_V>();
        Convert<T>::Store(output, u, elements);
        outputQueue_.EnQue(output);
        inputQueue_.FreeTensor(input);
    }

    __aicore__ inline void Compute(LocalTensor<T> input, uint32_t rows, bool shared,
                                   uint32_t trigOffset = 0)
    {
        if (!shared && HalfDim() * sizeof(T) % 32 == 0 && ContiguousBatch(rows)) {
            ComputeBatchedContiguous(input, rows);
            return;
        }
        if (shared && HalfDim() * sizeof(T) % 32 == 0) {
            ComputeContiguous(input, rows, trigOffset);
            return;
        }
        const uint32_t n = rows * RowStride();
        auto output = outputQueue_.template AllocTensor<T>();
        auto work = fpWork_.Get<float>();
        auto a = Convert<T>::Input(input, work, n);
        auto b = Convert<T>::Input(input[cfg_->tileElements], work[sizeof(T) == sizeof(float) ? 0 : cfg_->tileElements], n);
        auto u = Convert<T>::Output(output, work[sizeof(T) == sizeof(float) ? 0 : 2 * cfg_->tileElements]);
        auto v = Convert<T>::Output(output[cfg_->tileElements], work[sizeof(T) == sizeof(float) ? 0 : 3 * cfg_->tileElements]);
        auto temp = product_.Get<float>();
        auto cos = AngleBuffer(5)[trigOffset];
        auto sin = AngleBuffer(6)[trigOffset];
        PipeBarrier<PIPE_V>();

        MultiplyTrig(u, a, cos, rows, shared);
        MultiplyTrig(v, b, cos, rows, shared);
        MultiplyTrig(temp, b, sin, rows, shared);
        PipeBarrier<PIPE_V>();
        // b is dead after its two products. Reuse it to avoid a temp WAR stall.
        Sub(u, u, temp, n);
        MultiplyTrig(b, a, sin, rows, shared);
        PipeBarrier<PIPE_V>();
        Add(v, v, b, n);
        PipeBarrier<PIPE_V>();
        Convert<T>::Store(output, u, n);
        Convert<T>::Store(output[cfg_->tileElements], v, n);
        outputQueue_.EnQue(output);
        inputQueue_.FreeTensor(input);
    }

    __aicore__ inline void ProcessSharedToken(
        uint64_t token, uint32_t headBegin, uint32_t headCount,
        uint32_t trigOffset, bool prefetchNextToken)
    {
        const uint64_t firstRow = token * cfg_->heads + headBegin;
        const uint32_t tiles = (headCount + cfg_->tileHeads - 1) / cfg_->tileHeads;
        uint32_t initialRows = headCount < cfg_->tileHeads ? headCount : cfg_->tileHeads;
        for (uint32_t tile = 0; tile < tiles; ++tile) {
            const uint32_t offset = tile * cfg_->tileHeads;
            uint32_t rows = headCount - offset;
            if (rows > cfg_->tileHeads) rows = cfg_->tileHeads;
            auto input = inputQueue_.template DeQue<T>();
            if (tile + 1 < tiles) {
                uint32_t nextRows = headCount - offset - cfg_->tileHeads;
                if (nextRows > cfg_->tileHeads) nextRows = cfg_->tileHeads;
                CopyIn(firstRow + offset + cfg_->tileHeads, nextRows);
            } else if (prefetchNextToken) {
                // The other input buffer can fetch the next token while this
                // token's final tile is computed and stored.
                CopyIn(firstRow + cfg_->heads, initialRows);
            }
            Compute(input, rows, true, trigOffset);
            CopyOut(firstRow + offset, rows);
        }
    }

    __aicore__ inline void BroadcastTokenTrig(
        uint32_t token, uint32_t firstHead, uint32_t headCount)
    {
        auto cos = AngleBuffer(5);
        auto sin = AngleBuffer(6);
        const uint32_t source = token * RowStride();
        const uint32_t destination = (token * cfg_->heads + firstHead) * RowStride();
        CopyRepeatParams repeat{1, 1, static_cast<uint16_t>(RowStride() / 8), 0};
        for (uint32_t offset = 0; offset < RowStride(); offset += 64) {
            const uint64_t mask = RowStride() - offset < 64
                ? RowStride() - offset : 64;
            Copy(cos[destination + offset], cos[source + offset], mask,
                 static_cast<uint8_t>(headCount), repeat);
            Copy(sin[destination + offset], sin[source + offset], mask,
                 static_cast<uint8_t>(headCount), repeat);
        }
    }

    __aicore__ inline void ExpandTokenTrig(uint32_t tokens)
    {
        if (cfg_->heads == 1) return;
        uint32_t pending = tokens;
        while (pending > 1) {
            // All destinations in this stage start beyond every live compact
            // source. A barrier separates stages before source rows are reused.
            const uint32_t begin = (pending + cfg_->heads - 1) / cfg_->heads;
            for (uint32_t t = pending; t > begin; --t) {
                BroadcastTokenTrig(t - 1, 0, cfg_->heads);
            }
            PipeBarrier<PIPE_V>();
            pending = begin;
        }
        // Token zero is already in its final first-head slot. Skip that slot
        // so a broadcast instruction never overlaps its own source.
        BroadcastTokenTrig(0, 1, cfg_->heads - 1);
        PipeBarrier<PIPE_V>();
    }

    __aicore__ inline void ProcessTokenBatch(uint64_t firstToken)
    {
        uint32_t tokens = cfg_->batchTokens;
        if (cfg_->tokens - firstToken < tokens) tokens = cfg_->tokens - firstToken;
        const uint32_t rows = tokens * cfg_->heads;
        const uint64_t firstRow = firstToken * cfg_->heads;
        CopyIn(firstRow, rows);
        auto angle = AngleBuffer(0);
        auto freq = frequencies_.Get<float>();
        for (uint32_t t = 0; t < tokens; ++t) {
            const float position = static_cast<float>(Position(firstToken + t));
            Muls(angle[t * RowStride()], freq, position, RowStride());
        }
        PipeBarrier<PIPE_V>();
        FinishTrig(tokens * RowStride());
        ExpandTokenTrig(tokens);
        auto input = inputQueue_.template DeQue<T>();
        Compute(input, rows, false);
        CopyOut(firstRow, rows);
    }

    const Config* cfg_;
    TPipe pipe_;
    TQue<QuePosition::VECIN, 1> inputQueue_;
    TQue<QuePosition::VECOUT, 1> outputQueue_;
    TBuf<TPosition::VECIN> positionBuffer_;
    TBuf<TPosition::VECCALC> fpWork_, product_, frequencies_, angleWork_;
    GlobalTensor<T> x_, y_;
    GlobalTensor<int32_t> positions_;
    LocalTensor<int32_t> positionLocal_;
    uint64_t cacheStart_ = 0, cacheEnd_ = 0;
    bool positionLive_ = false;
};

// One complete FP32 D16/H1 token per core. Frequencies retain host powf bits.
struct OneTokenConfig {
    uint32_t wideAngles;
    float frequency[8];
};
static_assert(sizeof(OneTokenConfig) == 36, "one-token launch metadata");

class OneTokenKernel {
public:
    __aicore__ inline void Run(
        GM_ADDR x, GM_ADDR positions, GM_ADDR y, const OneTokenConfig& config)
    {
        cfg_ = &config;
        // A2 DataCopyPad supports VECIN <-> GM; all vector operands support VECIN.
        // input[0:16], output[16:32], position[32:40], frequency[40:48],
        // seven eight-float angle slots[48:104] are mutually 32B aligned.
        pipe_.InitBuffer(storage_, 104 * sizeof(float));
        auto memory = storage_.Get<float>();
        auto input = memory;
        auto output = memory[16];
        auto position = memory[32].ReinterpretCast<int32_t>();
        auto frequency = memory[40];
        const uint64_t token = GetBlockIdx();
        x_.SetGlobalBuffer((__gm__ float*)x);
        y_.SetGlobalBuffer((__gm__ float*)y);
        positions_.SetGlobalBuffer((__gm__ int32_t*)positions);
        const DataCopyExtParams rowCopy{1, 64, 0, 0, 0};
        const DataCopyPadExtParams<float> noPad{false, 0, 0, 0.0f};
        const DataCopyExtParams positionCopy{1, 4, 0, 0, 0};
        const DataCopyPadExtParams<int32_t> positionPad{true, 0, 7, 0};
        DataCopyPad(input, x_[token * 16], rowCopy, noPad);
        DataCopyPad(position, positions_[token], positionCopy, positionPad);
        const event_t inputReady =
            static_cast<event_t>(pipe_.FetchEventID(HardEvent::MTE2_V));
        SetFlag<HardEvent::MTE2_V>(inputReady);
        const event_t positionReady =
            static_cast<event_t>(pipe_.FetchEventID(HardEvent::MTE2_S));
        SetFlag<HardEvent::MTE2_S>(positionReady);
        WaitFlag<HardEvent::MTE2_S>(positionReady);
        const float p = static_cast<float>(position.GetValue(0));
        for (uint32_t i = 0; i < 8; ++i) frequency.SetValue(i, config.frequency[i]);
        const event_t frequencyReady =
            static_cast<event_t>(pipe_.FetchEventID(HardEvent::S_V));
        SetFlag<HardEvent::S_V>(frequencyReady);
        WaitFlag<HardEvent::S_V>(frequencyReady);
        Muls(AngleBuffer(0), frequency, p, 8);
        PipeBarrier<PIPE_V>();
        FinishTrig(8);
        WaitFlag<HardEvent::MTE2_V>(inputReady);

        auto cosine = AngleBuffer(5);
        auto sine = AngleBuffer(6);
        // Reduction scratch is dead. Two independent products allow all four
        // multiplications to share one vector barrier without changing rounding.
        auto crossA = AngleBuffer(0);
        auto crossB = AngleBuffer(1);
        Mul(output, input, cosine, 8);
        Mul(output[8], input[8], cosine, 8);
        Mul(crossA, input, sine, 8);
        Mul(crossB, input[8], sine, 8);
        PipeBarrier<PIPE_V>();
        Sub(output, output, crossB, 8);
        Add(output[8], output[8], crossA, 8);
        const event_t outputReady =
            static_cast<event_t>(pipe_.FetchEventID(HardEvent::V_MTE3));
        SetFlag<HardEvent::V_MTE3>(outputReady);
        WaitFlag<HardEvent::V_MTE3>(outputReady);
        DataCopyPad(y_[token * 16], output, rowCopy);
        const event_t outputDone =
            static_cast<event_t>(pipe_.FetchEventID(HardEvent::MTE3_S));
        SetFlag<HardEvent::MTE3_S>(outputDone);
        WaitFlag<HardEvent::MTE3_S>(outputDone);
    }

private:
    __aicore__ inline LocalTensor<float> AngleBuffer(uint32_t index)
    {
        return storage_.Get<float>()[48 + 8 * index];
    }

    __aicore__ inline void FinishTrig(uint32_t count)
    {
        auto angle = AngleBuffer(0);
        auto quotient = AngleBuffer(1);
        auto quotientInt = AngleBuffer(2).template ReinterpretCast<int32_t>();
        auto product = AngleBuffer(3);
        auto reduced = angle;
        auto cos = AngleBuffer(5);
        auto sin = AngleBuffer(6);
        if (cfg_->wideAngles) {
            // Rare theta<1 path: bounded quotient reduction is insufficient.
            // Only UB data is read here; global-memory traffic remains vectorized.
            const event_t toScalar =
                static_cast<event_t>(pipe_.FetchEventID(HardEvent::V_S));
            SetFlag<HardEvent::V_S>(toScalar);
            WaitFlag<HardEvent::V_S>(toScalar);
            for (uint32_t i = 0; i < count; ++i) {
                reduced.SetValue(i, ReduceAnglePayneHanek(angle.GetValue(i)));
            }
            const event_t toVector =
                static_cast<event_t>(pipe_.FetchEventID(HardEvent::S_V));
            SetFlag<HardEvent::S_V>(toVector);
            WaitFlag<HardEvent::S_V>(toVector);
        } else {
            // Preserve the FP32-rounded position * inverse-frequency product.
            // Never evaluate position * (log-frequency) as a fused approximation.
            Muls(quotient, angle, 0.15915494309189533577f, count);
            PipeBarrier<PIPE_V>();
            Cast(quotientInt, quotient, RoundMode::CAST_RINT, count);
            PipeBarrier<PIPE_V>();
            Cast(quotient, quotientInt, RoundMode::CAST_NONE, count);
            PipeBarrier<PIPE_V>();

            // q <= 20861. Products q*(201/32) and q*(507/2^18) are
            // exactly representable in FP32, so either fused or separate Axpy
            // gives the same subtraction result as the original Mul/Sub pair.
            // The nonexact third product deliberately keeps separate rounding.
            Muls(sin, quotient, 1.2556659143567085e-6f, count);
            Axpy(reduced, quotient, -6.28125f, count);
            PipeBarrier<PIPE_V>();
            Axpy(reduced, quotient, -0.001934051513671875f, count);
            PipeBarrier<PIPE_V>();
            Sub(reduced, reduced, sin, count);
            PipeBarrier<PIPE_V>();

        }

        // On the reduced domain, sin and cos share z = |r| * (pi - |r|).
        // This avoids two repeated generic range reductions in high-level APIs.
        auto absAngle = AngleBuffer(4);
        auto width = quotient;
        auto z = AngleBuffer(2);
        auto centered = product;
        Abs(absAngle, reduced, count);
        PipeBarrier<PIPE_V>();
        Muls(width, absAngle, -1.0f, count);
        PipeBarrier<PIPE_V>();
        Adds(centered, width, 1.57079637050628662109f, count);
        PipeBarrier<PIPE_V>();
        Adds(width, width, 3.14159274101257324219f, count);
        PipeBarrier<PIPE_V>();
        Adds(centered, centered, -4.371138828673793e-8f, count);
        Adds(width, width, -8.742277657347586e-8f, count);
        PipeBarrier<PIPE_V>();
        Mul(z, absAngle, width, count);
        Mul(reduced, reduced, width, count);
        PipeBarrier<PIPE_V>();

        Muls(sin, z, 2.580631073747187e-7f, count);
        Muls(cos, z, 2.3889217773452806e-8f, count);
        PipeBarrier<PIPE_V>();
        Adds(sin, sin, 2.1560553672307594e-5f, count);
        Adds(cos, cos, 2.457805570135570e-6f, count);
        PipeBarrier<PIPE_V>();
        Mul(sin, sin, z, count);
        Mul(cos, cos, z, count);
        PipeBarrier<PIPE_V>();
        Adds(sin, sin, 1.160294554180584e-3f, count);
        Adds(cos, cos, 1.726966512531477e-4f, count);
        PipeBarrier<PIPE_V>();
        Mul(sin, sin, z, count);
        Mul(cos, cos, z, count);
        PipeBarrier<PIPE_V>();
        Adds(sin, sin, 3.2251527327119334e-2f, count);
        Adds(cos, cos, 6.9616269567191625e-3f, count);
        PipeBarrier<PIPE_V>();
        Mul(sin, sin, z, count);
        Mul(cos, cos, z, count);
        PipeBarrier<PIPE_V>();
        Adds(sin, sin, 3.183098865345572e-1f, count);
        Adds(cos, cos, 1.2900613822529625e-1f, count);
        PipeBarrier<PIPE_V>();
        Mul(sin, sin, reduced, count);
        Mul(cos, cos, z, count);
        PipeBarrier<PIPE_V>();
        Adds(cos, cos, 6.366197723507009e-1f, count);
        PipeBarrier<PIPE_V>();
        Mul(cos, cos, centered, count);
        PipeBarrier<PIPE_V>();
    }

    const OneTokenConfig* cfg_;
    TPipe pipe_;
    TBuf<TPosition::VECIN> storage_;
    GlobalTensor<float> x_, y_;
    GlobalTensor<int32_t> positions_;
};
} // namespace rope_draft

template<class T, uint32_t FixedDim = 0>
__global__ __vector__ void rotary_pos_emb_draft(
    GM_ADDR x, GM_ADDR positions, GM_ADDR y, rope_draft::KernelConfig<FixedDim> config)
{
    rope_draft::Kernel<T, FixedDim> kernel;
    kernel.Init(x, positions, y, config);
    kernel.Process();
}

__global__ __vector__ void rotary_pos_emb_one_token(
    GM_ADDR x, GM_ADDR positions, GM_ADDR y, rope_draft::OneTokenConfig config)
{
    rope_draft::OneTokenKernel kernel;
    kernel.Run(x, positions, y, config);
}

extern "C" void run_kernel(
    GM_ADDR x, const TensorGroupInfo& info_x,
    GM_ADDR positions, const TensorGroupInfo& info_positions,
    GM_ADDR y, const TensorGroupInfo& info_y,
    int64_t availableCoreNum, aclrtStream stream, float theta)
{
    using namespace rope_draft;
    if (!info_x.tensors || !info_positions.tensors || !info_y.tensors ||
        info_x.numTensors != 1 || info_positions.numTensors != 1 ||
        info_y.numTensors != 1) {
        return;
    }
    const auto& in = info_x.tensors[0];
    const auto& pos = info_positions.tensors[0];
    const auto& out = info_y.tensors[0];
    if (in.numDims != 4 || pos.numDims != 2 || out.numDims != 4 ||
        !in.shape || !pos.shape || !out.shape ||
        (in.dtype != 0 && in.dtype != 1) || pos.dtype != 5 || out.dtype != in.dtype) {
        return;
    }
    if (!std::isfinite(theta) || theta <= 0.0f || availableCoreNum <= 0) {
        return;
    }
    for (uint32_t i = 0; i < 4; ++i) {
        if (in.shape[i] < 0 || in.shape[i] != out.shape[i]) return;
        if (in.shape[i] == 0) return; // defensive empty-tensor no-op
    }
    if (in.shape[0] > 128 || in.shape[1] > 8192 || in.shape[2] > 256 ||
        in.shape[3] < 16 || in.shape[3] > 1024 || in.shape[3] % 2 != 0 ||
        pos.shape[0] != in.shape[0] || pos.shape[1] != in.shape[1]) {
        return;
    }
    const uint64_t tinyTokens = uint64_t(in.shape[0]) * in.shape[1];
    if (in.dtype == 0 && in.shape[2] == 1 && in.shape[3] == 16 &&
        tinyTokens <= static_cast<uint64_t>(availableCoreNum) && tinyTokens <= 65535u) {
        OneTokenConfig tiny{};
        tiny.wideAngles = theta < 1.0f;
        for (uint32_t i = 0; i < 8; ++i) {
            const float exponent = static_cast<float>(2 * i) / 16.0f;
            tiny.frequency[i] = 1.0f / ::powf(theta, exponent);
        }
        const uint32_t tinyBlocks = static_cast<uint32_t>(tinyTokens);
        rotary_pos_emb_one_token<<<tinyBlocks, nullptr, stream>>>(x, positions, y, tiny);
        return;
    }
    LaunchConfig cfg{};
    cfg.tokens = uint64_t(in.shape[0]) * in.shape[1];
    cfg.wideAngles = theta < 1.0f;
    cfg.heads = in.shape[2];
    cfg.dim = in.shape[3];
    cfg.halfDim = cfg.dim / 2;
    const uint32_t typeBytes = in.dtype == 0 ? 4 : 2;
    const uint32_t rowAlignment = 32 / typeBytes;
    cfg.rowStride = CeilDiv(cfg.halfDim, rowAlignment) * rowAlignment;
    const uint32_t cores = availableCoreNum > 65535 ? 65535 : availableCoreNum;
    const uint64_t inputBytes = cfg.tokens * cfg.heads * cfg.dim * typeBytes;
    const bool smallWork = inputBytes <= 32768u;
    // Keep all available cores. Only combine two short coefficient windows.
    const uint32_t workPartitions = cores * (smallWork ? 1u : 2u);
    const uint32_t tokenAlignment =
        32 / Gcd(cfg.heads * cfg.dim * typeBytes, 32);
    const uint32_t maxBatch = kMaxAngles / (cfg.heads * cfg.rowStride);

    cfg.tileElements = kSmallTileElements;
    cfg.batched = cfg.heads <= 4 && maxBatch >= tokenAlignment;
    if (cfg.batched) {
        // Keep multiple work units per core without fragmenting small tensors.
        uint32_t batch = CeilDiv(static_cast<uint32_t>(cfg.tokens), workPartitions);
        if (smallWork) batch = CeilDiv(batch, tokenAlignment) * tokenAlignment;
        batch = Min(maxBatch, batch);
        batch = (batch / tokenAlignment) * tokenAlignment;
        if (batch == 0) batch = tokenAlignment;
        cfg.batchTokens = batch;
        cfg.angleCapacity = batch * cfg.heads * cfg.rowStride;
        cfg.workUnits = (cfg.tokens + batch - 1) / batch;
    } else {
        cfg.headGroup = cfg.heads;
        cfg.tokenGrain = tokenAlignment;
        // Split heads only on naturally aligned full-row boundaries.
        if (cfg.dim * typeBytes % 32 == 0 && cfg.tokens < cores) {
            const uint32_t groups = Min(cfg.heads, CeilDiv(cores, cfg.tokens));
            cfg.headGroup = CeilDiv(cfg.heads, groups);
        }
        cfg.groups = CeilDiv(cfg.heads, cfg.headGroup);
        // Large head groups benefit from a wider I/O tile; smaller groups keep
        // more angle slots for batching tokens within the same UB budget.
        // Size I/O storage for the rows a vector repeat can actually consume.
        if (Min(cfg.headGroup, kMaxHeadRepeats) * cfg.rowStride > kSmallTileElements) {
            cfg.tileElements = kHalfTileElements;
        }
        // 4K I/O plus 1536 angle slots stays below 192 KiB for every D/dtype.
        const uint32_t angleLimit = cfg.tileElements == kHalfTileElements
            ? 3 * kMaxAngles / 4 : kMaxAngles;
        if (cfg.groups == 1) {
            const uint32_t maxTokens = angleLimit / cfg.rowStride;
            uint32_t grain = Min(maxTokens,
                CeilDiv(static_cast<uint32_t>(cfg.tokens), workPartitions));
            if (smallWork) grain = CeilDiv(grain, tokenAlignment) * tokenAlignment;
            grain = (grain / tokenAlignment) * tokenAlignment;
            if (grain >= tokenAlignment) cfg.tokenGrain = grain;
        }
        cfg.tileHeads = Min(kMaxHeadRepeats, cfg.tileElements / cfg.rowStride);
        cfg.angleCapacity = Min(cfg.tokenGrain, angleLimit / cfg.rowStride) * cfg.rowStride;
        cfg.workUnits = ((cfg.tokens + cfg.tokenGrain - 1) / cfg.tokenGrain)
                        * cfg.groups;
    }
    cfg.blockCount = cfg.workUnits < cores ? cfg.workUnits : cores;

    // Match the reference's positive power followed by FP32 reciprocal.
    // pow(theta, -exponent) and exp(-log(theta)*exponent) round differently.
    cfg.encodedFrequency = cfg.halfDim > kRawFrequencyCapacity;
    union FloatBits { float f; uint32_t u; } ratio;
    ratio.f = ::powf(theta, -2.0f / static_cast<float>(cfg.dim));
    if (cfg.encodedFrequency) cfg.frequency.packed.ratioBits = ratio.u;
    uint32_t previous = 0;
    bool normalProducts = true;
    for (uint32_t i = 0; i < cfg.halfDim; ++i) {
        const float exponent = static_cast<float>(2 * i) / static_cast<float>(cfg.dim);
        const float power = ::powf(theta, exponent);
        union FloatBits { float f; uint32_t u; } current;
        current.f = 1.0f / power;
        if (!cfg.encodedFrequency) {
            cfg.frequency.raw[i] = current.f;
        } else {
            const uint32_t group = i / 3;
            const uint32_t lane = i % 3;
            if (lane == 0) {
                cfg.frequency.packed.anchor[group] = current.u;
            } else {
                const uint32_t expA = previous >> 23, expB = ratio.u >> 23;
                normalProducts = normalProducts && expA > 0 && expA < 255
                    && expB > 0 && expB < 255 && expA + expB >= 128
                    && expA + expB <= 380;
                const uint32_t predicted = host_math::MultiplyPositiveRne(previous, ratio.u);
                const int64_t correction = int64_t(current.u) - int64_t(predicted);
                if (correction < -32768 || correction > 32767) return;
                cfg.frequency.packed.residual[2 * group + lane - 1] = int16_t(correction);
            }
            previous = current.u;
        }
    }

    if (cfg.encodedFrequency && normalProducts) cfg.encodedFrequency |= 256u;

    if (in.dtype == 0) {
        if (cfg.dim == 16) {
            const auto compact = MakeCompactConfig<8>(cfg);
            rotary_pos_emb_draft<float, 16><<<cfg.blockCount, nullptr, stream>>>(x, positions, y, compact);
        } else if (cfg.dim == 32) {
            const auto compact = MakeCompactConfig<16>(cfg);
            rotary_pos_emb_draft<float, 32><<<cfg.blockCount, nullptr, stream>>>(x, positions, y, compact);
        } else if (cfg.dim == 64) {
            const auto compact = MakeCompactConfig<32>(cfg);
            rotary_pos_emb_draft<float, 64><<<cfg.blockCount, nullptr, stream>>>(x, positions, y, compact);
        } else if (cfg.dim == 128) {
            const auto compact = MakeCompactConfig<64>(cfg);
            rotary_pos_emb_draft<float, 128><<<cfg.blockCount, nullptr, stream>>>(x, positions, y, compact);
        } else {
            rotary_pos_emb_draft<float><<<cfg.blockCount, nullptr, stream>>>(x, positions, y, cfg);
        }
    } else {
        if (cfg.dim == 16) {
            const auto compact = MakeCompactConfig<8>(cfg);
            rotary_pos_emb_draft<half, 16><<<cfg.blockCount, nullptr, stream>>>(x, positions, y, compact);
        } else if (cfg.dim == 32) {
            const auto compact = MakeCompactConfig<16>(cfg);
            rotary_pos_emb_draft<half, 32><<<cfg.blockCount, nullptr, stream>>>(x, positions, y, compact);
        } else if (cfg.dim == 64) {
            const auto compact = MakeCompactConfig<32>(cfg);
            rotary_pos_emb_draft<half, 64><<<cfg.blockCount, nullptr, stream>>>(x, positions, y, compact);
        } else if (cfg.dim == 128) {
            const auto compact = MakeCompactConfig<64>(cfg);
            rotary_pos_emb_draft<half, 128><<<cfg.blockCount, nullptr, stream>>>(x, positions, y, compact);
        } else {
            rotary_pos_emb_draft<half><<<cfg.blockCount, nullptr, stream>>>(x, positions, y, cfg);
        }
    }

}
