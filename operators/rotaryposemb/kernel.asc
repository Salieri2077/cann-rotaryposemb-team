#include <cmath>
#include <cstdint>
#include <vector>
#include "kernel_operator.h"

// Included by main.asc; TensorGroupInfo and ACL declarations come from the caller.
using namespace AscendC;

namespace {
__aicore__ inline uint32_t Align32(uint32_t bytes)
{
    return (bytes + 31U) / 32U * 32U;
}

__aicore__ inline void ToFloat(LocalTensor<float> dst, LocalTensor<float> src, uint32_t n)
{
    Adds(dst, src, 0.0f, n);
}
__aicore__ inline void ToFloat(LocalTensor<float> dst, LocalTensor<half> src, uint32_t n)
{
    Cast(dst, src, RoundMode::CAST_NONE, n);
}
__aicore__ inline void FromFloat(LocalTensor<float> dst, LocalTensor<float> src, uint32_t n)
{
    Adds(dst, src, 0.0f, n);
}
__aicore__ inline void FromFloat(LocalTensor<half> dst, LocalTensor<float> src, uint32_t n)
{
    Cast(dst, src, RoundMode::CAST_RINT, n);
}

template <typename T>
class KernelRotary {
public:
    __aicore__ inline void Init(GM_ADDR x, GM_ADDR positions, GM_ADDR y, GM_ADDR inv,
                                uint64_t rows, uint32_t heads, uint32_t dim)
    {
        rows_ = rows;
        heads_ = heads;
        dim_ = dim;
        n_ = dim / 2U;
        xGm_.SetGlobalBuffer((__gm__ T *)x);
        yGm_.SetGlobalBuffer((__gm__ T *)y);
        posGm_.SetGlobalBuffer((__gm__ int32_t *)positions);
        invGm_.SetGlobalBuffer((__gm__ float *)inv);
        uint32_t bytes = Align32(n_ * static_cast<uint32_t>(sizeof(T)));
        uint32_t floats = Align32(n_ * static_cast<uint32_t>(sizeof(float)));
        pipe_.InitBuffer(x1Q_, 1, bytes);
        pipe_.InitBuffer(x2Q_, 1, bytes);
        pipe_.InitBuffer(y1Q_, 1, bytes);
        pipe_.InitBuffer(y2Q_, 1, bytes);
        pipe_.InitBuffer(invQ_, 1, floats);
        pipe_.InitBuffer(posQ_, 1, 32U);
        pipe_.InitBuffer(angleBuf_, floats);
        pipe_.InitBuffer(sinBuf_, floats);
        pipe_.InitBuffer(cosBuf_, floats);
        pipe_.InitBuffer(f1Buf_, floats);
        pipe_.InitBuffer(f2Buf_, floats);
        pipe_.InitBuffer(t1Buf_, floats);
        pipe_.InitBuffer(t2Buf_, floats);
    }

    __aicore__ inline void Process()
    {
        uint64_t begin = static_cast<uint64_t>(GetBlockIdx()) * rows_ / GetBlockNum();
        uint64_t end = (static_cast<uint64_t>(GetBlockIdx()) + 1U) * rows_ / GetBlockNum();
        if (begin == end) return;

        LocalTensor<float> inv = invQ_.AllocTensor<float>();
        DataCopyExtParams fp{1, n_ * static_cast<uint32_t>(sizeof(float)), 0, 0, 0};
        DataCopyPadExtParams<float> fpad{false, 0, 0, 0.0f};
        DataCopyPad(inv, invGm_, fp, fpad);
        invQ_.EnQue(inv);
        inv = invQ_.DeQue<float>();

        LocalTensor<float> angle = angleBuf_.Get<float>();
        LocalTensor<float> s = sinBuf_.Get<float>();
        LocalTensor<float> c = cosBuf_.Get<float>();
        LocalTensor<float> f1 = f1Buf_.Get<float>();
        LocalTensor<float> f2 = f2Buf_.Get<float>();
        LocalTensor<float> t1 = t1Buf_.Get<float>();
        LocalTensor<float> t2 = t2Buf_.Get<float>();
        uint64_t cachedToken = UINT64_MAX;
        for (uint64_t row = begin; row < end; ++row) {
            uint64_t token = row / heads_;
            if (token != cachedToken) {
                LocalTensor<int32_t> p = posQ_.AllocTensor<int32_t>();
                DataCopyExtParams pp{1, static_cast<uint32_t>(sizeof(int32_t)), 0, 0, 0};
                DataCopyPadExtParams<int32_t> ppad{false, 0, 0, 0};
                DataCopyPad(p, posGm_[token], pp, ppad);
                posQ_.EnQue(p);
                p = posQ_.DeQue<int32_t>();
                float position = static_cast<float>(p.GetValue(0));
                posQ_.FreeTensor(p);
                // Round the original FP32 angle before exact power-of-two scaling.
                Muls(angle, inv, position, n_);
                Muls(angle, angle, 0.5f, n_);
                Muls(angle, angle, 0.5f, n_);
                // For theta >= 1 and |position| <= 131072, |angle| <= 32768.
                // A2 Sin/Cos require |input| <= 65504. Accuracy needs NPU testing.
                Sin(s, angle, n_);
                Cos(c, angle, n_);
                for (uint32_t step = 0; step < 2U; ++step) {
                    Mul(t1, s, c, n_);
                    Mul(t2, s, s, n_);
                    Mul(c, c, c, n_);
                    Sub(c, c, t2, n_);
                    Muls(s, t1, 2.0f, n_);
                }
                cachedToken = token;
            }

            // Preserve 64-bit element offsets, including the second half.
            uint64_t offset = row * static_cast<uint64_t>(dim_);
            DataCopyExtParams copy{1, n_ * static_cast<uint32_t>(sizeof(T)), 0, 0, 0};
            DataCopyPadExtParams<T> pad{false, 0, 0, static_cast<T>(0)};
            LocalTensor<T> x1 = x1Q_.AllocTensor<T>();
            LocalTensor<T> x2 = x2Q_.AllocTensor<T>();
            DataCopyPad(x1, xGm_[offset], copy, pad);
            DataCopyPad(x2, xGm_[offset + n_], copy, pad);
            x1Q_.EnQue(x1);
            x2Q_.EnQue(x2);
            x1 = x1Q_.DeQue<T>();
            x2 = x2Q_.DeQue<T>();
            ToFloat(f1, x1, n_);
            ToFloat(f2, x2, n_);
            LocalTensor<T> y1 = y1Q_.AllocTensor<T>();
            LocalTensor<T> y2 = y2Q_.AllocTensor<T>();
            Mul(t1, f1, c, n_);
            Mul(t2, f2, s, n_);
            Sub(t1, t1, t2, n_);
            FromFloat(y1, t1, n_);
            Mul(t2, f2, c, n_);
            Mul(t1, f1, s, n_);
            Add(t2, t2, t1, n_);
            FromFloat(y2, t2, n_);
            x1Q_.FreeTensor(x1);
            x2Q_.FreeTensor(x2);
            y1Q_.EnQue(y1);
            y2Q_.EnQue(y2);
            y1 = y1Q_.DeQue<T>();
            y2 = y2Q_.DeQue<T>();
            DataCopyPad(yGm_[offset], y1, copy);
            DataCopyPad(yGm_[offset + n_], y2, copy);
            y1Q_.FreeTensor(y1);
            y2Q_.FreeTensor(y2);
        }
        invQ_.FreeTensor(inv);
    }

private:
    TPipe pipe_;
    TQue<TPosition::VECIN, 1> x1Q_, x2Q_, invQ_, posQ_;
    TQue<TPosition::VECOUT, 1> y1Q_, y2Q_;
    TBuf<TPosition::VECCALC> angleBuf_, sinBuf_, cosBuf_;
    TBuf<TPosition::VECCALC> f1Buf_, f2Buf_, t1Buf_, t2Buf_;
    GlobalTensor<T> xGm_, yGm_;
    GlobalTensor<int32_t> posGm_;
    GlobalTensor<float> invGm_;
    uint64_t rows_;
    uint32_t heads_, dim_, n_;
};
} // namespace

template <typename T>
__global__ __vector__ void rotary_pos_emb_custom(
    GM_ADDR x, GM_ADDR positions, GM_ADDR y, GM_ADDR inv,
    uint64_t rows, uint32_t heads, uint32_t dim)
{
    KernelRotary<T> op;
    op.Init(x, positions, y, inv, rows, heads, dim);
    op.Process();
}

extern "C" void run_kernel(GM_ADDR x, const TensorGroupInfo& info_x,
                           GM_ADDR positions, const TensorGroupInfo& info_positions,
                           GM_ADDR y, const TensorGroupInfo& info_y,
                           int64_t availableCoreNum, aclrtStream stream, float theta)
{
    if (info_x.tensors == nullptr || info_x.numTensors < 1) return;
    const auto& tensor = info_x.tensors[0];
    const int64_t* shape = tensor.shape;
    if (shape == nullptr || tensor.numDims != 4 ||
        (tensor.dtype != 0 && tensor.dtype != 1)) return;
    if (shape[0] <= 0 || shape[1] <= 0 || shape[2] <= 0 ||
        shape[2] > UINT32_MAX || shape[3] < 2 || shape[3] > UINT32_MAX ||
        shape[3] % 2 != 0) return;
    uint32_t heads = static_cast<uint32_t>(shape[2]);
    uint32_t dim = static_cast<uint32_t>(shape[3]);
    uint64_t rows = static_cast<uint64_t>(shape[0]) * static_cast<uint64_t>(shape[1]) * heads;
    uint32_t n = dim / 2U;
    std::vector<float> invFreq(n);
    for (uint32_t i = 0; i < n; ++i) {
        // numpy: arange(0, dim, 2, dtype=float32) / dim, NOT i / dim.
        float exponent = static_cast<float>(2U * i) / static_cast<float>(dim);
        float power = std::pow(theta, exponent);
        invFreq[i] = 1.0f / power;
    }
    size_t bytes = static_cast<size_t>(n) * sizeof(float);
    void* invDev = nullptr;
    if (aclrtMalloc(&invDev, bytes, ACL_MEM_MALLOC_HUGE_FIRST) != ACL_SUCCESS) return;
    if (aclrtMemcpy(invDev, bytes, invFreq.data(), bytes, ACL_MEMCPY_HOST_TO_DEVICE) != ACL_SUCCESS) {
        aclrtFree(invDev);
        return;
    }
    uint64_t cores = availableCoreNum > 0 ? static_cast<uint64_t>(availableCoreNum) : 1U;
    if (cores > rows) cores = rows;
    if (cores > UINT32_MAX) cores = UINT32_MAX;
    uint32_t blocks = static_cast<uint32_t>(cores);
    if (tensor.dtype == 0) {
        rotary_pos_emb_custom<float><<<blocks, nullptr, stream>>>(
            x, positions, y, (GM_ADDR)invDev, rows, heads, dim);
    } else {
        rotary_pos_emb_custom<half><<<blocks, nullptr, stream>>>(
            x, positions, y, (GM_ADDR)invDev, rows, heads, dim);
    }
    // Keep the small frequency table alive until all device reads complete.
    aclrtSynchronizeStream(stream);
    aclrtFree(invDev);
}
